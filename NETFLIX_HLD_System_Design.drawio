  <diagram id="ott-hld" name="OTT Platform HLD">
    <mxGraphModel dx="875" dy="491" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="fLMe5nyKj1RyIqYZNgI8-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="150" width="610" x="920" y="330" as="geometry" />
        </mxCell>
        <mxCell id="title" parent="1" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#1a73e8;align=left;verticalAlign=middle;" value="OTT Platform (Netflix) — High Level Design" vertex="1">
          <mxGeometry height="40" width="900" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="fr_title" parent="1" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;fontColor=#333333;" value="1. Functional Requirements" vertex="1">
          <mxGeometry height="24" width="300" x="40" y="120" as="geometry" />
        </mxCell>
        <mxCell id="fr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=none;strokeColor=#6c8ebf;fontSize=12;arcSize=6;" value="• User can create an account and opt for a subscription plan&#xa;• User can search and find movies/shows by title or name&#xa;• User can watch videos in multiple resolutions (480p / 1080p / 4K)&#xa;• User should be able to watch without noticeable/negligible buffering&#xa;• Admin/content team can upload new videos and metadata" vertex="1">
          <mxGeometry height="150" width="400" x="40" y="148" as="geometry" />
        </mxCell>
        <mxCell id="nfr_title" parent="1" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;fontColor=#333333;" value="Non-Functional Requirements" vertex="1">
          <mxGeometry height="24" width="300" x="570" y="112" as="geometry" />
        </mxCell>
        <mxCell id="nfr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=none;strokeColor=light-dark(#D6B656,#FFFFFF);fontSize=12;arcSize=6;" value="• Scale: ~200M users, ~10K total videos (~1 hr each)&#xa;• CAP theorem: Availability &gt;&gt; Consistency for streaming/browsing&#xa;  (Consistency matters for order &amp; payment flows)&#xa;• Low latency video streaming (use CDN + adaptive bitrate)&#xa;• High availability &amp; fault tolerance (no single point of failure)&#xa;• Durable storage for video files (no data loss)" vertex="1">
          <mxGeometry height="150" width="370" x="560" y="144" as="geometry" />
        </mxCell>
        <mxCell id="est_title" parent="1" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;fontColor=#333333;" value="Estimation" vertex="1">
          <mxGeometry height="24" width="200" x="1470" y="120" as="geometry" />
        </mxCell>
        <mxCell id="est" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=6;" value="10K videos, avg 1hr:&#xa;720p: 1GB/hr&#xa;1080p: 2GB/hr&#xa;1440p: 3GB/hr&#xa;----------------&#xa;Total ≈ 60TB&#xa;(10K × 6GB avg)" vertex="1">
          <mxGeometry height="150" width="150" x="1470" y="148" as="geometry" />
        </mxCell>
        <mxCell id="cap_title" parent="1" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;fontColor=#333333;" value="How Video Streaming Works" vertex="1">
          <mxGeometry height="24" width="350" x="1230" y="350" as="geometry" />
        </mxCell>
        <mxCell id="cap" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=6;" value="1. Video split into small chunks&#xa;2. Each chunk encoded at multiple&#xa;   resolutions (adaptive bitrate)&#xa;3. Client requests manifest (.m3u8)&#xa;4. Player fetches chunks from CDN,&#xa;   switching quality based on&#xa;   network speed" vertex="1">
          <mxGeometry height="150" width="370" x="1030" y="130" as="geometry" />
        </mxCell>
        <mxCell id="hld_title" parent="1" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;fontColor=#333333;" value="&amp;nbsp;High Level Design" vertex="1">
          <mxGeometry height="26" width="400" x="40" y="515" as="geometry" />
        </mxCell>
        <mxCell id="client" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=default;fontSize=12;fontStyle=1;arcSize=10;" value="Client Apps&#xa;(Web / Mobile / Smart TV)" vertex="1">
